# ==============================================================================
# DuesPilot Unified Environment Configuration Template (.env.example)
#
# RULE: Exactly one .env file and one .env.example at repository root.
# NEVER commit .env. Commit only this template with placeholders.
# Copy this file to .env and fill in required values:
#   cp .env.example .env
# ==============================================================================

# ==============================================================================
# 1. Backend & Database Configuration (Spring Boot 4 / PostgreSQL)
# ==============================================================================
PORT=8080
SERVER_PORT=8080
DEMO_MODE=replay
RATE_LIMIT_RPM=60
DAILY_COST_CAP_MICROS=5000000
PER_CASE_COST_CAP_MICROS=250000
LLM_MAX_INFLIGHT=8

# Database Credentials
POSTGRES_DB=duespilot
POSTGRES_USER=duespilot
POSTGRES_PASSWORD=duespilot
POSTGRES_PORT=5432
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/duespilot
SPRING_DATASOURCE_USERNAME=duespilot
SPRING_DATASOURCE_PASSWORD=duespilot
DATABASE_URL=jdbc:postgresql://localhost:5432/duespilot
DATABASE_URL_DIRECT=jdbc:postgresql://localhost:5432/duespilot

# Supabase Auth Verification (Backend JWKS Resource Server)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_JWKS_URI=https://YOUR-PROJECT-REF.supabase.co/auth/v1/.well-known/jwks.json
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080

# AI Models & Web Search Providers
# Nebius Token Factory (NVIDIA Nemotron 3 Nano/Super/Ultra)
NEBIUS_API_KEY=
LLM_BASE_URL=https://api.tokenfactory.nebius.com/v1

# Tavily Search API (RBI Bank Rate verification)
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com

# ==============================================================================
# 2. Frontend Configuration (Vite Single Page Application - VITE_*)
#
# CRITICAL SECURITY NOTE:
# Only variables prefixed with VITE_ are bundled into client code.
# NEVER prefix database passwords, secret keys, or service-role keys with VITE_.
# ==============================================================================
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
VITE_API_BASE_URL=http://localhost:8080
VITE_SMTP_CONFIGURED=false
VITE_MOCK_API=false

# ==============================================================================
# 3. Optional Communication Providers (Sandbox mode active by default)
# ==============================================================================
NOTIFY_SANDBOX=true
NOTIFY_SANDBOX_EMAIL=owner@duespilot.local
NOTIFY_SANDBOX_PHONE=+919999999999

# Resend Email Delivery
RESEND_API_KEY=
RESEND_BASE_URL=https://api.resend.com
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_WEBHOOK_SECRET=

# Meta WhatsApp Cloud API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=duespilot-verify-token
WHATSAPP_APP_SECRET=
WHATSAPP_BASE_URL=https://graph.facebook.com

# ==============================================================================
# 4. GitHub-Only Values (CI/CD Secrets & Cron Workflows)
# ==============================================================================
# GitHub Secrets: SUPABASE_URL, SUPABASE_ANON_KEY (used in keep-supabase-alive workflow)
# Optional health probe URL for Cloud Run (do NOT set for Render)
CLOUD_RUN_BACKEND_URL=
